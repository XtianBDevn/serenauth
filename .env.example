# ============================================================
# SerenAuth — local development environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- API (ASP.NET Core) ---------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# JWT signing key (HS256). Use a random 64+ byte secret in production.
# Generate one with: ./infrastructure/scripts/gen-jwt-secret.sh
Jwt__Issuer=serenauth.local
Jwt__Audience=serenauth.web
Jwt__SigningKey=replace-me-with-a-64-byte-random-string-do-not-ship-this

# MongoDB connection (replica set required for transactions in prod)
Mongo__ConnectionString=mongodb://serenauth:serenauth@mongo:27017/?authSource=admin
Mongo__Database=serenauth

# Seeding (set to false in production)
Seeding__Enabled=true

# CORS allowlist (comma-separated origins)
Cors__AllowedOrigins=http://localhost:3000

# Rate limiting
RateLimit__PermitLimit=100
RateLimit__WindowSeconds=60

# --- Web (Next.js) -------------------------------------------
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# --- MongoDB (container) -------------------------------------
MONGO_INITDB_ROOT_USERNAME=serenauth
MONGO_INITDB_ROOT_PASSWORD=serenauth
